#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

mapfile -t STAGED_PATHS < <(git diff --cached --name-only)
PYTHON_BIN="${PYTHON:-python3}"

"$PYTHON_BIN" scripts/planner_architecture_doc_guard.py --check-changed-docs "${STAGED_PATHS[@]}"
"$PYTHON_BIN" scripts/planner_architecture_doc_guard.py --check-architecture-contract
"$PYTHON_BIN" scripts/planner_architecture_doc_guard.py --check-doc-inventory
