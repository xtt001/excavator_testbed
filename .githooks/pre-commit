#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

mapfile -t STAGED_PATHS < <(git diff --cached --name-only)
PYTHON_BIN="${PYTHON:-python3}"

"$PYTHON_BIN" scripts/planner_refactor_guard.py --check-historical-files "${STAGED_PATHS[@]}"
"$PYTHON_BIN" scripts/planner_refactor_guard.py --check-plan-contract
"$PYTHON_BIN" scripts/planner_refactor_guard.py --check-skill-contract
